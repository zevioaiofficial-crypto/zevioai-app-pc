{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zevio-ai-cloud",
  "main": "./cloudflare/worker.js",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  }
}